#include <iostream>   // Библиотека для ввода/вывода
#include <clocale>    // Библиотека для русского языка
#include <vector>     // Библиотека для создания списков
#include <string>     // Библиотека для работы с текстом
#include <algorithm>  // Библиотека для работы с min/max
#include <ctime>      // Библиотека для генератора случайных чисел
#include <conio.h>    // Библиотека для паузы

using namespace std;

// Класс (Футболист)
class Player {
protected:

    // 1. Свойства (Характеристики)
    string name;      // Имя
    string position;  // Позиция (FWD, MID, DEF, GK)
    int shooting;     // Сила/Точность удара
    int passing;      // Сила/Точность паса
    int dribbling;    // Дриблинг
    int defending;    // Защита
    int stamina;      // Выносливость

    // Валидация (Статистика)
    int validateStat(int value) {
        if (value > 99) return 99;
        if (value < 1) return 1;
        return value;
    }

public:    
    // 2. Конструктор (Игрок)
    Player(string n, string pos, int shot, int pass, int drib, int def, int stam) {
        name = n;
        position = pos;
        shooting = validateStat(shot);
        passing = validateStat(pass);
        dribbling = validateStat(drib);
        defending = validateStat(def);
        setStamina(stam);
    }

    // Функция (Общий рейтинг "OVR")
    virtual int getOVR() {
        if (position == "FWD") {
            // Нападающий: Удар важнее всего
            return (shooting * 0.7) + (dribbling * 0.3);
        }
        else if (position == "DEF") {
            // Защитник: Защита в приоритете
            return (defending * 0.8) + (passing * 0.2);
        }
        else if (position == "MID") {
            // Полузащитник: Баланс паса и контроля
            return (passing * 0.5) + (shooting * 0.2) + (dribbling * 0.3);
        }
        // Если позиция не определена - просто среднее
        return (shooting + passing + dribbling + defending) / 4;
    }

    // Геттеры (Безопасный доступ на чтение)
    string getName() { return name; }
    string getPosition() { return position; }
    int getShooting() { return shooting; }
    int getPassing() { return passing; }
    int getDribbling() { return dribbling; }
    int getDefending() { return defending; }
    int getStamina() { return stamina; }

    // Валидация (Стамина)
    void setStamina(int value) {
        if (value > 100) stamina = 100;
        else if (value < 0) stamina = 0;
        else stamina = value;
    }

    // 3. Метод (Карточка игрока)
    virtual void printStats() {
        cout << "[" << position << "] " << name << " [OVR: " << getOVR() << "] "
            << " | Удар: " << shooting
            << " | Пас: " << passing
            << " | Дриблинг: " << dribbling
            << " | Защита: " << defending
            << " | Выносливость: " << stamina << "%\n";
    }
};

// Класс (Вратарь)
class Goalkeeper : public Player {
private:
    int reflexes;
    int jumping;

public:
    // Конструктор (Вратарь)
    Goalkeeper(string n, string pos, int shot, int pass, int drib, int def, int stam, int refl, int jump)
        : Player(n, "GK", shot, pass, drib, def, stam) // Вызов родителя
    {
        // Валидация (Рефлексы)
        if (refl > 99) reflexes = 99;
        else if (refl < 1) reflexes = 1;
        else reflexes = refl;

        // Валидация (Прыжки)
        if (jump > 99) jumping = 99;
        else if (jump < 1) jumping = 1;
        else jumping = jump;
    }

    // Функция (Общий рейтинг вратаря "OVR)
    int getOVR() {
        return (reflexes * 0.4) + (jumping * 0.5) + (getPassing() * 0.1);
    }

    // Геттер (Рефлексы и прыжки)
    int getReflexes() { return reflexes; }
    int getJumping() { return jumping; }

    // Функция (Вывод статистик)
    void printStats() {
        cout << "[GK] " << getName() << " [OVR: " << getOVR() << "] "
            << " | Рефлексы: " << reflexes
            << " | Прыжки: " << jumping
            << " | Выносливость: " << getStamina() << "%\n";
    }
};

// Класс (Команда)
class Team {
public:
    string teamName;
    vector<Player*> roster; // Вектор (Состав)

    // Конструктор команды
    Team(string tName) {
        teamName = tName;
    }

    // Метод (Добавление игрока)
    void addPlayer(Player* p) {
        roster.push_back(p);
    }

    // Метод (Состав)
    void printTeam() {
        cout << "=== Состав команды " << teamName << ":" << "=== \n";
        int TeamTotalOVR = 0;

        if (roster.empty()) {
            cout << "В команде нет игроков.\n";
            return;
        }
        
        for (Player* p : roster) {
            p->printStats();
            TeamTotalOVR += p->getOVR();
        }

        if (roster.size() > 0) {
            int avgOVR = TeamTotalOVR / roster.size();
            cout << "---------------------------" << endl;
            cout << "Средний рейтинг команды: [" << avgOVR << "]" << endl;
            cout << "-----------------------" << endl;
        }
        cout << "====================================\n";
    }

    ~Team() { // Деструктор - срабатывает при удалении команды
        for (Player* p : roster) {
            delete p; // Чистим память, выделенную через new
        }
        roster.clear();
    }
};

// Функция (Пауза)
void pause() {
    cout << "\n ";
    _getch();
}

// Класс (Матч)
class Match {
public:
    Team* homeTeam;
    Team* awayTeam;
    int scoreHome = 0;
    int scoreAway = 0;

    Match(Team* h, Team* a) {
        homeTeam = h;
        awayTeam = a;
        srand(time(0));
    }
    
    // Функция (Только полевой игрок)
    Player& getRandomOutfieldPlayer(Team* team) {
        vector<Player*> outfield;
        for (auto p : team->roster) {

            if (p->getPosition() != "GK") outfield.push_back(p);
        }
        return *outfield[rand() % outfield.size()];
    }

    // Функция (Рассчет успеха)
    bool calculateSuccess(Player& p, int homeStat, int oppStat) {
        // 1. Рассчитываем коэффициент усталости
        double fatigueMultiplier = p.getStamina() / 100.0;

        // 2. Реальный стат с учетом усталости
        int effectiveStat = homeStat * (fatigueMultiplier + fatigueMultiplier / 2 + 0.01);
        int opponentStat = oppStat;

        int total = effectiveStat + opponentStat;
        if (total <= 0) return false;

        int chance = (effectiveStat * 100) / total;
        return (rand() % 100) < chance;
    }

    Player* getGoalkeeper(Team* team) {

        for (Player* p : team->roster) {

            if (p->getPosition() == "GK") return p;
        }
        return nullptr;
    }


    // Функция (Безопасный ввод)
    int getSafeAction() {
        int action;

        while (!(cin >> action) || (action != 1 && action != 2)) {
            cout << "\n[Ошибка] Выберите 1 или 2: ";
            cin.clear();

            while (cin.get() != '\n');
        }
        return action;
    }

    void triggerCounterAttack() {

        Player& homePlayer = getRandomOutfieldPlayer(homeTeam);
        Player& oppPlayer = getRandomOutfieldPlayer(awayTeam);
        
        Player* hGK = getGoalkeeper(homeTeam);
        int gkSaveStat = (hGK != nullptr) ? hGK->getOVR() : 50;

        cout << "\n[!!!] Соперник перехватил мяч и летит в контратаку!" << endl;

        pause();

        cout << oppPlayer.getName() << " приближается к воротам с мячом!" << endl;

        pause();

        cout << homePlayer.getName() << " пытается прервать атаку..." << endl;
        cout << "Что делать? 1. Защищаться | 2. Ждать удара" << endl;
        cout << "Ваш выбор: ";

        int action = getSafeAction;

        if (action == 1) {

            if (calculateSuccess(homePlayer, homePlayer.getDefending(), oppPlayer.getDribbling())) {
                cout << "\n[УСПЕХ!] " << homePlayer.getName() << " отобрал мяч, владение восстановлено!" << endl;
                homePlayer.setStamina(homePlayer.getStamina() - 10);
                oppPlayer.setStamina(oppPlayer.getStamina() - 10);
            }

            else {
                cout << "\n[ОПАСНО!] " << oppPlayer.getName() << " филигранно обыграл и бьет по воротам..." << endl;
                homePlayer.setStamina(homePlayer.getStamina() - 10);
                oppPlayer.setStamina(oppPlayer.getStamina() - 15);

                if (calculateSuccess(oppPlayer, oppPlayer.getShooting(), gkSaveStat)) {
                    cout << "\n[ГОЛ!] " << oppPlayer.getName() << " мощно пробил и не оставил шансов вратарю!" << endl;
                    scoreAway++;
                    oppPlayer.setStamina(oppPlayer.getStamina() - 10);
                }

                else {
                    cout << "\n[ФУХХХХ!] Вратарь спасает команду!" << endl;
                    oppPlayer.setStamina(oppPlayer.getStamina() - 10);
                }

                if (hGK) hGK->setStamina(hGK->getStamina() - 10);
                cout << "\nОстаток сил вратаря:  " << hGK->getStamina() << "%" << endl;

                pause();
            }
        }

        else if (action == 2) {

            if (calculateSuccess(oppPlayer, oppPlayer.getShooting(), gkSaveStat)) {
                cout << "\n[ГОЛ!] " << oppPlayer.getName() << " мощно пробил и не оставил шансов вратарю!" << endl;
                scoreAway++;
                oppPlayer.setStamina(oppPlayer.getStamina() - 10);
            }

            else if (int(rand() % 100) > 80) {
                cout << "\n[УСПЕХ!] Повезло, мяч попал прямо в защитника!" << endl;
                oppPlayer.setStamina(oppPlayer.getStamina() - 10);
            }

            if (hGK != nullptr) hGK->setStamina(hGK->getStamina() - 10);
            cout << "\nОстаток сил вратаря: " << hGK->getStamina() << "%" << endl;
        }
    }

    void startQuickMatch() {
        cout << "\n====================================" << endl;
        cout << "   МАТЧ НАЧИНАЕТСЯ: " << homeTeam->teamName << " vs " << awayTeam->teamName << endl;
        cout << "====================================\n" << endl;

        // ЦИКЛ: Играем 5 игровых эпизодов
        for (int i = 1; i <= 5; i++) {

            Player& hPlayer = getRandomOutfieldPlayer(homeTeam);
            Player& oPlayer = getRandomOutfieldPlayer(awayTeam);
            
            Player* oppGK = getGoalkeeper(awayTeam);
            int gkSaveStats = (oppGK != nullptr) ? oppGK->getOVR() : 50;

            cout << "--- ЭПИЗОД №" << i << " ---" << endl;
            cout << "Мяч у игрока: " << hPlayer.getName() << " (" << hPlayer.getPosition() << ")" << endl;
            cout << "Против него защищается:  " << oPlayer.getName() << " (Защита: " << oPlayer.getDefending() << ")" << endl;
            cout << "Что делаем? 1. Дриблинг | 2. Пас" << endl;
            cout << "Ваш выбор: ";

            int action = getSafeAction;

            if (action == 1) {
                if (calculateSuccess(hPlayer, hPlayer.getDribbling(), oPlayer.getDefending())) {
                    cout << "\n[!] " << hPlayer.getName() << " обыграл защитника!" << endl;
                    cout << "Бьем по воротам? 1. Да | 2. Нет, пас назад" << endl;
                    cout << "Ваш выбор: ";
                    hPlayer.setStamina(hPlayer.getStamina() - 15);
                    oPlayer.setStamina(oPlayer.getStamina() - 10);

                    if (action == 1) {

                        if (calculateSuccess(hPlayer, hPlayer.getShooting(), gkSaveStats)) {
                            cout << "\n[ГООООЛ!] Счет становится солиднее!" << endl;
                            scoreHome++;
                            hPlayer.setStamina(hPlayer.getStamina() - 10);

                        }

                        else {
                            cout << "\n[СЕЙВ!] Вратарь на месте." << endl;
                            hPlayer.setStamina(hPlayer.getStamina() - 10);
                        }

                        if (oppGK != nullptr) oppGK->setStamina(oppGK->getStamina() - 10);
                        cout << "\nОстаток сил вратаря: " << oppGK->getStamina() << "%" << endl;
                    }

                    else {
                        cout << "\nРешили не рисковать, атака продолжается позиционно." << endl;
                        hPlayer.setStamina(hPlayer.getStamina() - 5);
                    }
                }

                else {
                    cout << "\n[ПОТЕРЯ!] Защитник отобрал мяч." << endl;
                    hPlayer.setStamina(hPlayer.getStamina() - 15);
                    oPlayer.setStamina(oPlayer.getStamina() - 10);
                    triggerCounterAttack();
                }
            }

            else {
                if (calculateSuccess(hPlayer, hPlayer.getPassing(), 50)) {
                    cout << "\n[ОК] Точный пас, владение сохранено." << endl;
                    hPlayer.setStamina(hPlayer.getStamina() - 5);
                }

                else {
                    cout << "\n[!] Перехват! Соперник контратакует." << endl;
                    hPlayer.setStamina(hPlayer.getStamina() - 5);
                    oPlayer.setStamina(oPlayer.getStamina() - 5);
                    triggerCounterAttack();
                }
            }

            cout << "\nОстаток сил " << hPlayer.getName() << ": " << hPlayer.getStamina() << "%" << endl;
            cout << "\nОстаток сил " << oPlayer.getName() << ": " << oPlayer.getStamina() << "%" << endl;
            cout << "\nТекущий счет: " << scoreHome << ":" << scoreAway << endl;
            cout << "\nНажмите любую клавишу для следующего хода...";
            pause()
        }

        cout << "====================================" << endl;
        cout << "ФИНАЛЬНЫЙ СВИСТОК!" << endl;
        cout << "ИТОГОВЫЙ СЧЕТ: " << scoreHome << ":" << scoreAway << endl;
        cout << "====================================\n" << endl;
    }
};

// Функция (Главное меню) 
void showMenu() {
    cout << "====================================\n";
    cout << "             GOALOGIC               \n";
    cout << "====================================\n";
    cout << "1. Быстрый матч\n";
    cout << "2. Режим Турнира\n";
    cout << "3. Команда\n";
    cout << "4. Выход\n";
    cout << "====================================\n";
    cout << "Ваш выбор: ";
}

int main() {
    setlocale(LC_ALL, "Russian");

    // 1. Создаем твою команду
    Team myTeam("FC GoaLogic");
    myTeam.addPlayer(new Player("L. Messi", "FWD", 88, 94, 97, 36, 100));
    myTeam.addPlayer(new Player("C. Ronaldo", "FWD", 93, 98, 94, 41, 100));
    myTeam.addPlayer(new Player("K. De Bruyne", "MID", 95, 82, 87, 57, 100));
    myTeam.addPlayer(new Player("D. Korolev", "DEF", 99, 99, 99, 99, 100));
    myTeam.addPlayer(new Player("A. Sayatevich", "MID", 69, 68, 67, 66, 1));
    myTeam.addPlayer(new Goalkeeper("M. Neuer", "GK", 30, 81, 46, 53, 100, 97, 93));

    int choice;

    while (true) {
        showMenu();
        // Проверка на корректность ввода числа
        if (!(cin >> choice)) {
            cout << "\n[Ошибка] Вводи только цифры!\n";
            cin.clear(); // Сбрасываем ошибку
            while (cin.get() != '\n'); // Очищаем буфер ввода
            continue;
        }

        if (choice == 1) {
            // Создание команды противника
            Team opponent("AFC Goalogic");
            opponent.addPlayer(new Player("H. Kane", "FWD", 91, 79, 84, 32, 100));
            opponent.addPlayer(new Player("L. Martinez", "FWD", 90, 76, 87, 35, 100));
            opponent.addPlayer(new Player("R. Cherki", "MID", 82, 93, 95, 52, 100));
            opponent.addPlayer(new Player("W. Saliba", "DEF", 68, 84, 29, 95, 100));
            opponent.addPlayer(new Player("D. Huijsen", "DEF", 63, 81, 37, 89, 100));
            opponent.addPlayer(new Goalkeeper("E. Martinez", "GK", 23, 71, 35, 40, 100, 83, 82));

            // Создание матча
            Match currentMatch(&myTeam, &opponent);
            currentMatch.startQuickMatch();
        }

        else if (choice == 2) {
            cout << "\n[!] Формирование турнирной сетки...\n\n";
        }

        else if (choice == 3) {
            cout << "\nСостав вашей команды:\n";
            myTeam.printTeam();
            cout << "\nНажмите любую клавишу, чтобы вернуться в меню...\n\n";
            _getch();
        }

        else if (choice == 4) {
            cout << "\nФинальный свисток! До встречи в Goalogic.\n";
            return 0;
        }

        else {
            cout << "\n[Ошибка] Мяч вне поля! Выбери 1, 2 или 3.\n\n";
        }
    }

    return 0;
}
