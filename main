#include <iostream>   // Библиотека для ввода/вывода
#include <clocale>    // Библиотека для русского языка
#include <vector>     // Библиотека для создания списков
#include <string>     // Библиотека для работы с текстом
#include <algorithm>  // Библиотека для работы с min/max
#include <ctime>      // Библиотека для генератора случайных чисел
#include <conio.h>    // Библиотека для работы с консолью

using namespace std;

// Класс (Футболист)
class Player {
private: // Закрываем доступ для филтьтрации статов

    // 1. Свойства (Характеристики)
    string name;      // Имя
    string position;  // Позиция (FWD, MID, DEF, GK)
    int shooting;     // Сила/Точность удара
    int passing;      // Сила/Точность паса
    int dribbling;    // Дриблинг
    int defending;    // Защита
    int stamina;      // Выносливость

    // Валидация для того, чтобы статы были в диапазоне [1, 99]
    int validateStat(int value) {
        if (value > 99) return 99;
        if (value < 1) return 1;
        return value;
    }

public:    
    // 2. Конструктор (Специальная функция, которая создает игрока)
    Player(string n, string pos, int shot, int pass, int drib, int def, int stam) {
        name = n;
        position = pos;
        shooting = validateStat(shot);
        passing = validateStat(pass);
        dribbling = validateStat(drib);
        defending = validateStat(def);
        setStamina(stam);
    }

    // Функция (Общий рейтинг "OVR")
    int getOVR() {
        if (position == "FWD") {
            // Нападающий: Удар важнее всего
            return (shooting * 0.7) + (dribbling * 0.3);
        }
        else if (position == "DEF") {
            // Защитник: Защита в приоритете
            return (defending * 0.8) + (passing * 0.2);
        }
        else if (position == "MID") {
            // Полузащитник: Баланс паса и контроля
            return (passing * 0.5) + (shooting * 0.2) + (dribbling * 0.3);
        }
        // Если позиция не определена - просто среднее
        return (shooting + passing + dribbling + defending) / 4;
    }

    // Геттеры (Безопасный доступ на чтение)
    string getName() { return name; }
    string getPosition() { return position; }
    int getShooting() { return shooting; }
    int getPassing() { return passing; }
    int getDribbling() { return dribbling; }
    int getDefending() { return defending; }
    int getStamina() { return stamina; }

    // Сеттер (Безопасное изменение данных)
    void setStamina(int value) {
        if (value > 100) stamina = 100;
        else if (value < 0) stamina = 0;
        else stamina = value;
    }

    // 3. Метод (Действие, которое выведет карточку игрока)
    void printStats() {
        cout << "[" << position << "] " << name << " [OVR: " << getOVR() << "] "
            << " | Удар: " << shooting
            << " | Пас: " << passing
            << " | Дриблинг: " << dribbling
            << " | Защита: " << defending
            << " | Выносливость: " << stamina << "%\n";
    }
};

// Класс (Команда)
class Team {
public:
    string teamName;           // Название команды
    vector<Player> roster;     // Состав (вектор/список, внутри которого лежат объекты Player)

    // Конструктор команды
    Team(string tName) {
        teamName = tName;
    }

    // Метод (Добавление игрока)
    void addPlayer(Player p) {
        roster.push_back(p); // Команда push_back закидывает игрока в конец списка
    }

    // Метод (Состав)
    void printTeam() {
        cout << "=== Состав команды " << teamName << ":" << "=== \n";
        int TeamTotalOVR = 0;

        for (int i = 0; i < roster.size(); i++) {
            roster[i].printStats();
            TeamTotalOVR += roster[i].getOVR();
        }

        if (roster.size() > 0) {
            int avgOVR = TeamTotalOVR / roster.size();
            cout <<
                "---------------------------" << endl;
            cout << "Средний рейтинг команды: [" << avgOVR << "]" << endl;
            cout << "-----------------------" << endl;
        }
        cout << "====================================\n";
    }
};

// Функция (Пауза)
void pause() {
    cout << "\n";
    _getch();
}

// Класс (Матч)
class Match {
public:
    Team* homeTeam;
    Team* awayTeam;
    int scoreHome = 0;
    int scoreAway = 0;

    Match(Team* h, Team* a) {
        homeTeam = h;
        awayTeam = a;
        srand(time(0));
    }
    
    // Функция (Рассчет успеха)
    bool calculateSuccess(Player& p, int statType, int opponentStat) {
        // 1. Рассчитываем коэффициент усталости
        // Если стамина 100, коэффициент = 1.0. Если стамина 50, коэффициент = 0.75.
        double fatigueMultiplier = p.getStamina() / 100.0;

        // 2. Реальный стат с учетом усталости
        int effectiveStat = statType * (fatigueMultiplier + fatigueMultiplier/2);

        int total = effectiveStat + opponentStat;
        if (total <= 0) return false;

        int chance = (effectiveStat * 100) / total;
        int diceRoll = rand() % 100;

        return diceRoll < chance;
    }

    void triggerCounterAttack() {
        cout << "\n[!!!] Соперник перехватил мяч и летит в контратаку!" << endl;

        // Выбираем случайного нападающего у противника
        int aiIndex = rand() % awayTeam->roster.size();
        Player& aiPlayer = awayTeam->roster[aiIndex];

        cout << aiPlayer.getName() << " приближается к воротам с мячом!" << endl;

        pause();

        int myDefIndex = rand() % homeTeam->roster.size();
        Player& myDefender = homeTeam->roster[myDefIndex];
        int goalkeeperSave = 50 + (rand() % 15);

        cout << myDefender.getName() << " пытается прервать атаку..." << endl;

        pause();

        if (calculateSuccess(aiPlayer, aiPlayer.getDribbling(), myDefender.getDefending())) {
            cout << "[ОПАСНО!] " << aiPlayer.getName() << " филигранно обыграл и бьет по воротам..." << endl;

            pause();

            if (calculateSuccess(aiPlayer, aiPlayer.getShooting(), goalkeeperSave)) {
                cout << "[ГОЛ] " << aiPlayer.getName() << " мощно пробил и не оставил шансов вратарю!" << endl;
                scoreAway++;
            }
            else {
                cout << "[ФУХХХХ!] Вратарь спасает команду!" << endl;
            }
        }
        else {
            cout << "[ЕСТЬ!] " << myDefender.getName() << " героически отобрал мяч!" << endl;
        }

    }

    void startQuickMatch() {
        cout << "\n====================================" << endl;
        cout << "   МАТЧ НАЧИНАЕТСЯ: " << homeTeam->teamName << " vs " << awayTeam->teamName << endl;
        cout << "====================================\n" << endl;

        // ЦИКЛ: Играем 5 игровых эпизодов
        for (int i = 1; i <= 5; i++) {
            cout << "--- ЭПИЗОД №" << i << " ---" << endl;

            int randomIndex = rand() % homeTeam->roster.size();
            Player& activePlayer = homeTeam->roster[randomIndex];

            int defenderTackling = 60 + (rand() % 20);
            int goalkeeperSave = 50 + (rand() % 15);

            cout << "Мяч у игрока: " << activePlayer.getName() << " (" << activePlayer.getPosition() << ")" << endl;
            cout << "1. Дриблинг | 2. Пас" << endl;
            cout << "Ваш выбор: ";

            int action;
            cin >> action;

            if (action == 1) {
                if (calculateSuccess(activePlayer, activePlayer.getDribbling(), defenderTackling)) {
                    cout << "[!] " << activePlayer.getName() << " обыграл защитника!" << endl;
                    cout << "Бьем по воротам? 1. Да | 2. Нет, пас назад" << endl;
                    activePlayer.setStamina(activePlayer.getStamina() - 25); //Тратим стамину
                    cin >> action;

                    if (action == 1) {
                        if (calculateSuccess(activePlayer, activePlayer.getShooting(), goalkeeperSave)) {
                            cout << "[ГООООЛ!] Счет становится солиднее!" << endl;
                            scoreHome++;
                            activePlayer.setStamina(activePlayer.getStamina() -10);
                        }
                        else {
                            cout << "[СЕЙВ] Вратарь на месте." << endl;
                            activePlayer.setStamina(activePlayer.getStamina() - 10);
                        }
                    }
                    else {
                        cout << "Решили не рисковать, атака продолжается позиционно." << endl;
                        activePlayer.setStamina(activePlayer.getStamina() - 5);
                    }
                }
                else {
                    cout << "[ПОТЕРЯ] Защитник отобрал мяч." << endl;
                    activePlayer.setStamina(activePlayer.getStamina() - 10);
                    triggerCounterAttack();
                }
            }
            else {
                if (calculateSuccess(activePlayer, activePlayer.getPassing(), 50)) {
                    cout << "[ОК] Точный пас, владение сохранено." << endl;
                    activePlayer.setStamina(activePlayer.getStamina() - 5);
                }
                else {
                    cout << "[!] Перехват! Соперник контратакует." << endl;
                    activePlayer.setStamina(activePlayer.getStamina() - 5);
                    triggerCounterAttack();
                }
            }

            cout << "\nОстаток сил " << activePlayer.getName() << ": " << activePlayer.getStamina() << "% \n" << endl;
            cout << "Текущий счет: " << scoreHome << ":" << scoreAway << "\n" << endl;
            cout << "Нажмите Enter для следующего хода...\n";
            cin.ignore(); // Очистка буфера после cin >> action
            cin.get();    // Ожидание нажатия Enter
        }

        cout << "====================================" << endl;
        cout << "ФИНАЛЬНЫЙ СВИСТОК!" << endl;
        cout << "ИТОГОВЫЙ СЧЕТ: " << scoreHome << ":" << scoreAway << endl;
        cout << "====================================\n" << endl;
    }
};

// Функция (Главное меню) 
void showMenu() {
    cout << "====================================\n";
    cout << "             GOALOGIC               \n";
    cout << "====================================\n";
    cout << "1. Быстрый матч\n";
    cout << "2. Режим Турнира\n";
    cout << "3. Команда\n";
    cout << "4. Выход\n";
    cout << "====================================\n";
    cout << "Ваш выбор: ";
}

int main() {
    setlocale(LC_ALL, "Russian");

    // 1. Создаем твою команду
    Team myTeam("FC GoaLogic");
    myTeam.addPlayer(Player("L. Messi", "FWD", 88, 94, 97, 36, 100));
    myTeam.addPlayer(Player("C. Ronaldo", "FWD", 93, 98, 94, 41, 100));
    myTeam.addPlayer(Player("K. De Bruyne", "MID", 95, 82, 87, 57, 100));
    myTeam.addPlayer(Player("Daniil Korolev", "DEF", 99, 99, 99, 99, 100));
    myTeam.addPlayer(Player("Artyom Sayatevich", "MID", 69, 68, 67, 66, 1));

    int choice;

    while (true) {
        showMenu();
        // Проверка на корректность ввода числа
        if (!(cin >> choice)) {
            cout << "\n[Ошибка] Вводи только цифры!\n";
            cin.clear(); // Сбрасываем ошибку
            while (cin.get() != '\n'); // Очищаем буфер ввода
            continue;
        }

        if (choice == 1) {
            // 2. Создаем противника (пока просто для теста)
            Team opponent("AFC Goalogic");
            opponent.addPlayer(Player("H. Kane", "FWD", 91, 79, 84, 32, 100));
            opponent.addPlayer(Player("L. Martinez", "FWD", 90, 76, 87, 35, 100));
            opponent.addPlayer(Player("R. Cherki", "MID", 82, 93, 95, 52, 100));
            opponent.addPlayer(Player("W. Saliba", "DEF", 68, 84, 29, 95, 100));
            opponent.addPlayer(Player("D. Huijsen", "DEF", 63, 81, 37, 89, 100));

            // 3. Создаем матч и запускаем его
            Match currentMatch(&myTeam, &opponent);
            currentMatch.startQuickMatch();
        }

        else if (choice == 2) {
            cout << "\n[!] Формирование турнирной сетки...\n\n";
        }

        else if (choice == 3) {
            cout << "\nСостав вашей команды:\n";
            myTeam.printTeam();
            cout << "\nНажмите любую клавишу, чтобы вернуться в меню...\n\n";
            _getch();
        }

        else if (choice == 4) {
            cout << "\nФинальный свисток! До встречи в Goalogic.\n";
            return 0;
        }

        else {
            cout << "\n[Ошибка] Мяч вне поля! Выбери 1, 2 или 3.\n\n";
        }
    }

    return 0;
}
